{
  "name": "flutter-config-manager",
  "displayName": "Flutter Config Manager",
  "description": "Manage Flutter Android/iOS/macOS permissions, services, and app name localizations. Update manifests, plists, Podfile, and AppDelegate from one VS Code UI.",
  "version": "1.0.15",
  "publisher": "hamza-shewa",
  "author": {
    "name": "Hamza Shewa",
    "email": "shewa.hz98@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hamza-Shewa/flutter-services-permission-manager"
  },
  "bugs": {
    "url": "https://github.com/Hamza-Shewa/flutter-services-permission-manager/issues"
  },
  "homepage": "https://github.com/Hamza-Shewa/flutter-services-permission-manager#readme",
  "icon": "images/flutter-config.png",
  "galleryBanner": {
    "color": "#0175C2",
    "theme": "dark"
  },
  "keywords": [
    "flutter",
    "vscode-extension",
    "permissions",
    "services",
    "android",
    "ios",
    "macos",
    "manifest",
    "plist",
    "podfile",
    "appdelegate",
    "applinks",
    "deep-linking",
    "configuration",
    "localization",
    "localizations",
    "app-name",
    "app-name-localization"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "workspaceContains:**/pubspec.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flutter-config-manager.edit",
        "title": "Flutter Config Manager: Edit Permissions & Services",
        "icon": {
          "light": "images/flutter-config.png",
          "dark": "images/flutter-config.png"
        }
      },
      {
        "command": "flutter-config-manager.checkUnusedAssets",
        "title": "Flutter Config Manager: Check Unused Assets"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flutterConfigSidebar",
          "title": "Flutter Config",
          "icon": "src/media/flutter-config.svg"
        }
      ]
    },
    "views": {
      "flutterConfigSidebar": [
        {
          "id": "flutterConfigView",
          "name": "Config Manager",
          "type": "webview",
          "icon": "src/media/flutter-config.svg"
        }
      ]
    },
    "configuration": {
      "title": "Flutter Config Manager",
      "properties": {
        "flutterConfigManager.enableDebug": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose debug logging for Flutter Config Manager in the developer console."
        },
        "flutter-config-manager.unusedAssets.ignoredDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Project-relative directories to skip when scanning for unused assets (e.g. \"lib/widgets\"). Custom widget wrappers that load assets dynamically can be excluded here."
        },
        "flutter-config-manager.unusedAssets.ignoredFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Files to skip when scanning for unused assets, by project-relative path or basename (e.g. \"my_image.dart\")."
        },
        "flutter-config-manager.unusedAssets.ignoredDynamicDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Directories whose dynamic asset patterns (e.g. \"assets/icons/$name\", Image.asset(path)) are ignored, while literal asset references still count as used. Use for files like constants/icon maps that mix static and dynamic references."
        },
        "flutter-config-manager.unusedAssets.ignoredDynamicFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Files whose dynamic asset patterns are ignored (by project-relative path or basename), while literal asset references still count as used."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "c8 vscode-test",
    "coverage:report": "c8 report --reporter=html",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.80.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "c8": "^11.0.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "vsce": "^2.15.0"
  }
}