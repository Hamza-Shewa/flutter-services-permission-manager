mcp-server/node_modules/.cache/**

# A tool-created git-worktree directory (e.g. Kilo Code's `.kilo/worktrees/<name>/`)
# duplicates the whole repo, including build/coverage output - never part of the
# extension itself, and must never ship.
.kilo/**

# `mcp-server/` is compiled ahead of time (`npm run compile:mcp`) into
# `mcp-server/out/`; only its own runtime `dependencies` (not `devDependencies`)
# are needed at runtime. vsce only understands the *root* package.json's
# dependency/devDependency split, so this nested project's own devDependencies
# (the entire TypeScript compiler + its `.d.ts` lib files, ~25MB) would
# otherwise be bundled wholesale.
mcp-server/node_modules/typescript/**
mcp-server/node_modules/@types/**

# Test fixtures, snapshot images, and docs bundled inside published npm
# packages themselves (not devDependencies - these ship with the package even
# in production installs) are never needed at runtime.
**/node_modules/**/test/**
**/node_modules/**/tests/**
**/node_modules/**/__image_snapshots__/**
**/node_modules/**/*.test.*
**/node_modules/**/docs/**
**/node_modules/zod/src/**

# `mcp-server` only ever imports `@modelcontextprotocol/sdk/server/mcp.js` and
# `.../server/stdio.js` (see `mcp-server/src/index.ts`) - it never uses the
# SDK's optional HTTP/SSE transport or OAuth support. Verified by tracing the
# actual require/import graph from the compiled entry point
# (`mcp-server/out/index.js`): none of the packages below, nor the SDK's own
# `server/auth/**`/`server/express.js`/`server/streamableHttp.js`/`examples/**`,
# are ever reachable at runtime - they're pure dead weight (~9MB) pulled in
# only because they're declared as the SDK's dependencies for a feature this
# server doesn't use.
mcp-server/node_modules/@hono/**
mcp-server/node_modules/hono/**
mcp-server/node_modules/express/**
mcp-server/node_modules/express-rate-limit/**
mcp-server/node_modules/body-parser/**
mcp-server/node_modules/cors/**
