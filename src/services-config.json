        {
          "id": "androidApiKey",
          "label": "Android API Key",
          "placeholder": "AIzaSy... (configured in AndroidManifest.xml)",
          "required": true
        }
      ],
      "ios": {
        "plistEntries": [],
        "urlSchemes": [],
        "appDelegate": {
          "import": "GoogleMaps",
          "code": "GMSServices.provideAPIKey(\"{iosApiKey}\")"
        }
      },
      "android": {
        "metaData": [
          {
            "name": "com.google.android.geo.API_KEY",
            "valueField": "androidApiKey",
            "stringResource": "google_maps_api_key"
          }
        ],
        "stringResources": [
          {
            "name": "google_maps_api_key",
            "valueField": "androidApiKey"
          }
        ],
        "queries": [],
        "applicationData": []
      }
    },
