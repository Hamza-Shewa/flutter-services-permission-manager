{
  "services": [
    {
      "id": "facebook",
      "name": "Facebook SDK",
      "description": "Facebook Login, Share, and Analytics",
      "icon": "📘",
      "fields": [
        {
          "id": "appId",
          "label": "App ID",
          "placeholder": "Your Facebook App ID (e.g., 1234567890)",
          "required": true,
          "pattern": "^[0-9]+$",
          "patternError": "Facebook App ID must contain digits only."
        },
        {
          "id": "clientToken",
          "label": "Client Token",
          "placeholder": "Your Facebook Client Token",
          "required": true
        },
        {
          "id": "displayName",
          "label": "Display Name",
          "placeholder": "Your App Display Name",
          "required": true
        }
      ],
      "ios": {
        "plistEntries": [
          {
            "key": "FacebookAppID",
            "valueField": "appId",
            "type": "string"
          },
          {
            "key": "FacebookClientToken",
            "valueField": "clientToken",
            "type": "string"
          },
          {
            "key": "FacebookDisplayName",
            "valueField": "displayName",
            "type": "string"
          },
          {
            "key": "LSApplicationQueriesSchemes",
            "type": "array",
            "staticValue": ["fbapi", "fb-messenger-share-api", "fbauth2", "fbshareextension"]
          }
        ],
        "urlSchemes": [
          {
            "prefix": "fb",
            "valueField": "appId"
          }
        ],
        "appDelegate": {
          "import": "FBSDKCoreKit",
          "code": "ApplicationDelegate.shared.application(application, didFinishLaunchingWithOptions: launchOptions)"
        }
      },
      "android": {
        "metaData": [
          {
            "name": "com.facebook.sdk.ApplicationId",
            "valueField": "appId",
            "stringResource": "facebook_app_id"
          },
          {
            "name": "com.facebook.sdk.ClientToken",
            "valueField": "clientToken",
            "stringResource": "facebook_client_token"
          }
        ],
        "stringResources": [
          {
            "name": "facebook_app_id",
            "valueField": "appId"
          },
          {
            "name": "facebook_client_token",
            "valueField": "clientToken"
          },
          {
            "name": "fb_login_protocol_scheme",
            "valueField": "appId",
            "prefix": "fb"
          }
        ],
        "queries": [
          {
            "tag": "provider",
            "attributes": {
              "android:authorities": "com.facebook.katana.provider.PlatformProvider"
            }
          }
        ],
        "applicationData": [
          {
            "tag": "activity",
            "attributes": {
              "android:name": "com.facebook.FacebookActivity",
              "android:configChanges": "keyboard|keyboardHidden|screenLayout|screenSize|orientation",
              "android:label": "@string/app_name"
            }
          },
          {
            "tag": "activity",
            "attributes": {
              "android:name": "com.facebook.CustomTabActivity",
              "android:exported": "true"
            },
            "children": [
              {
                "tag": "intent-filter",
                "children": [
                  { "tag": "action", "attributes": { "android:name": "android.intent.action.VIEW" } },
                  { "tag": "category", "attributes": { "android:name": "android.intent.category.DEFAULT" } },
                  { "tag": "category", "attributes": { "android:name": "android.intent.category.BROWSABLE" } },
                  { "tag": "data", "attributes": { "android:scheme": "@string/fb_login_protocol_scheme" } }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "firebase",
      "name": "Firebase Cloud Messaging",
      "description": "Push notifications via Firebase",
      "icon": "🔥",
      "setupNotes": [
        "Run flutterfire configure and initialize Firebase from Dart with DefaultFirebaseOptions.currentPlatform.",
        "This service manages notification-channel metadata only; it does not replace FlutterFire CLI setup or Dart initialization."
      ],
      "fields": [
        {
          "id": "channelId",
          "label": "Notification Channel ID",
          "placeholder": "high_importance_channel",
          "required": false
        }
      ],
      "ios": {
        "plistEntries": [],
        "urlSchemes": []
      },
      "android": {
        "metaData": [
          {
            "name": "com.google.firebase.messaging.default_notification_channel_id",
            "valueField": "channelId",
            "defaultValue": "high_importance_channel"
          }
        ],
        "queries": [],
        "applicationData": []
      }
    },
    {
      "id": "applinks",
      "name": "App Links / Universal Links",
      "description": "Deep linking for Android App Links and iOS Universal Links",
      "icon": "🔗",
      "setupNotes": [
        "Deploy the generated association files from .flutter-config-manager/app-links-hosting to every listed HTTPS domain.",
        "The extension configures HTTPS App Links and Universal Links; custom URL schemes belong in a separate integration."
      ],
      "fields": [
        {
          "id": "domains",
          "label": "Associated Domains",
          "placeholder": "example.com, www.example.com",
          "required": true,
          "type": "list"
        },
        {
          "id": "packageName",
          "label": "Android Package Name",
          "placeholder": "com.example.app",
          "required": true,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$",
          "patternError": "Enter a valid Android application ID."
        },
        {
          "id": "sha256CertFingerprints",
          "label": "SHA-256 Cert Fingerprints",
          "placeholder": "AA:BB:... (comma separated)",
          "required": false,
          "type": "list"
        },
        {
          "id": "teamId",
          "label": "Apple Team ID",
          "placeholder": "ABCDE12345",
          "required": true,
          "pattern": "^[A-Z0-9]{10}$",
          "patternError": "Apple Team ID must contain 10 uppercase letters or digits."
        },
        {
          "id": "bundleId",
          "label": "iOS Bundle ID",
          "placeholder": "com.example.app.ios",
          "required": true,
          "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$",
          "patternError": "Enter a valid iOS bundle identifier."
        },
        {
          "id": "flutterDeepLinkingEnabled",
          "label": "Flutter Deep Linking Enabled (true/false)",
          "placeholder": "false",
          "required": false,
          "type": "toggle"
        }
      ],
      "ios": {
        "plistEntries": [],
        "urlSchemes": []
      },
      "android": {
        "metaData": [],
        "queries": [],
        "applicationData": []
      }
    },
    {
      "id": "onesignal",
      "name": "OneSignal",
      "description": "OneSignal Flutter SDK setup checklist",
      "icon": "🔔",
      "setupNotes": [
        "Import lib/flutter_config_manager_services.dart and call OneSignal.initialize with FlutterConfigManagerServices.oneSignalAppId during Dart startup.",
        "On iOS, add Push Notifications, Background Modes, an App Group, and a OneSignalNotificationServiceExtension target in Xcode. The extension does not create Xcode targets automatically."
      ],
      "dartConstants": [
        { "name": "oneSignalAppId", "valueField": "appId" }
      ],
      "fields": [
        {
          "id": "appId",
          "label": "OneSignal App ID",
          "placeholder": "Your OneSignal App ID (UUID)",
          "required": true,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
          "patternError": "OneSignal App ID must be a valid UUID."
        }
      ],
      "ios": {
        "plistEntries": [],
        "urlSchemes": []
      },
      "android": {
        "metaData": [],
        "queries": [],
        "applicationData": []
      }
    },
    {
      "id": "twitter",
      "name": "Twitter/X OAuth Callback",
      "description": "Native callback routing for a Twitter/X OAuth client",
      "icon": "🐦",
      "setupNotes": [
        "Register the same callback URL in the X developer portal and pass it to your Dart OAuth client.",
        "OAuth credentials are deliberately not stored in native project files or extension logs."
      ],
      "fields": [
        {
          "id": "callbackScheme",
          "label": "Callback Scheme",
          "placeholder": "myapp",
          "required": true,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*$",
          "patternError": "Callback scheme must start with a letter and contain only letters, digits, +, -, or ."
        },
        {
          "id": "callbackHost",
          "label": "Callback Host (optional)",
          "placeholder": "oauth"
        }
      ],
      "ios": {
        "plistEntries": [
          {
            "key": "LSApplicationQueriesSchemes",
            "type": "array",
            "staticValue": ["twitter", "twitterauth"]
          }
        ],
        "urlSchemes": [
          {
            "valueField": "callbackScheme",
            "urlName": "twitter-oauth"
          }
        ]
      },
      "android": {
        "metaData": [],
        "queries": [
          {
            "tag": "package",
            "attributes": {
              "android:name": "com.twitter.android"
            }
          }
        ],
        "applicationData": [],
        "mainActivityIntentFilters": [
          {
            "tag": "intent-filter",
            "children": [
              { "tag": "action", "attributes": { "android:name": "android.intent.action.VIEW" } },
              { "tag": "category", "attributes": { "android:name": "android.intent.category.DEFAULT" } },
              { "tag": "category", "attributes": { "android:name": "android.intent.category.BROWSABLE" } },
              { "tag": "data", "attributes": { "android:scheme": "{callbackScheme}", "android:host": "{callbackHost}" } }
            ]
          }
        ]
      }
    },
    {
      "id": "apple_signin",
      "name": "Apple Sign-In",
      "description": "Sign in with Apple (iOS 13+)",
      "icon": "🍎",
      "setupNotes": [
        "The iOS entitlement and Android callback activity are configured here.",
        "A Service ID is needed only for Web or Android authentication and must also be used by your Dart and server-side sign-in flow."
      ],
      "dartConstants": [
        { "name": "appleServiceId", "valueField": "serviceId" }
      ],
      "fields": [
        {
          "id": "serviceId",
          "label": "Service ID (Web/Android only)",
          "placeholder": "Your Apple Service ID",
          "required": false
        }
      ],
      "ios": {
        "plistEntries": [],
        "urlSchemes": [],
        "entitlements": [
          {
            "key": "com.apple.developer.applesignin",
            "type": "array",
            "staticValue": ["Default"]
          }
        ]
      },
      "android": {
        "metaData": [],
        "queries": [],
        "applicationData": [
          {
            "tag": "activity",
            "attributes": {
              "android:name": "com.aboutyou.dart_packages.sign_in_with_apple.SignInWithAppleCallback",
              "android:exported": "true"
            },
            "children": [
              {
                "tag": "intent-filter",
                "children": [
                  { "tag": "action", "attributes": { "android:name": "android.intent.action.VIEW" } },
                  { "tag": "category", "attributes": { "android:name": "android.intent.category.DEFAULT" } },
                  { "tag": "category", "attributes": { "android:name": "android.intent.category.BROWSABLE" } },
                  { "tag": "data", "attributes": { "android:scheme": "signinwithapple", "android:path": "callback" } }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "stripe",
      "name": "Stripe Payments",
      "description": "Stripe payment processing with flutterstripe URL scheme for payment callbacks",
      "icon": "💳",
      "setupNotes": [
        "Import lib/flutter_config_manager_services.dart, initialize Stripe.publishableKey from FlutterConfigManagerServices.stripePublishableKey, set Stripe.urlScheme to flutterstripe, then call applySettings.",
        "When Apple Pay is enabled, also set Stripe.merchantIdentifier in Dart and enable the merchant in your Apple developer account."
      ],
      "dartConstants": [
        { "name": "stripePublishableKey", "valueField": "publishableKey" },
        { "name": "stripeMerchantId", "valueField": "merchantId" }
      ],
      "fields": [
        {
          "id": "publishableKey",
          "label": "Publishable Key",
          "placeholder": "pk_live_xxx or pk_test_xxx",
          "required": true,
          "pattern": "^pk_(?:test|live)_[A-Za-z0-9_]+$",
          "patternError": "Enter a Stripe publishable key beginning with pk_test_ or pk_live_."
        },
        {
          "id": "merchantId",
          "label": "Merchant ID (Apple Pay)",
          "placeholder": "merchant.com.yourcompany",
          "required": false,
          "pattern": "^merchant\\.[A-Za-z0-9.-]+$",
          "patternError": "Apple merchant IDs must begin with merchant."
        }
      ],
      "ios": {
        "plistEntries": [],
        "urlSchemes": [
          {
            "staticValue": "flutterstripe",
            "urlName": "flutterstripe"
          }
        ],
        "entitlements": [
          {
            "key": "com.apple.developer.in-app-payments",
            "type": "array",
            "valueField": "merchantId"
          }
        ]
      },
      "android": {
        "metaData": [],
        "queries": [],
        "applicationData": [],
        "mainActivityIntentFilters": [
          {
            "tag": "intent-filter",
            "children": [
              { "tag": "action", "attributes": { "android:name": "android.intent.action.VIEW" } },
              { "tag": "category", "attributes": { "android:name": "android.intent.category.DEFAULT" } },
              { "tag": "category", "attributes": { "android:name": "android.intent.category.BROWSABLE" } },
              { "tag": "data", "attributes": { "android:scheme": "flutterstripe", "android:host": "redirect" } }
            ]
          }
        ]
      }
    },
    {
      "id": "maps",
      "name": "Google Maps",
      "description": "Google Maps SDK (iOS: AppDelegate.swift, Android: AndroidManifest.xml)",
      "icon": "🗺️",
      "fields": [
        {
          "id": "iosApiKey",
          "label": "iOS API Key",
          "placeholder": "AIzaSy... (configured in AppDelegate.swift)",
          "required": false
